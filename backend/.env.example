# Copie este arquivo para ".env" e preencha com valores reais. Nunca commite o ".env".

PORT=3333

# String de conexão do Postgres (Neon). Formato: postgresql://user:password@host/db?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Segredo usado para assinar os tokens JWT de autenticação. Gere um valor aleatório longo.
JWT_SECRET="troque-por-um-segredo-aleatorio-longo"

# Chaves VAPID para notificações Web Push. Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL="mailto:seuemail@exemplo.com"

# Origem permitida para CORS (URL do frontend em desenvolvimento)
FRONTEND_URL="http://localhost:5173"
