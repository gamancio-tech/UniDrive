generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DailyStatusValue {
  vai_normal
  so_ida
  so_volta
  nao_vai
}

enum MarkedBy {
  student
  driver
}

model Admin {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  isSuperAdmin  Boolean  @default(false)
  createdAt     DateTime @default(now())

  pushSubscriptions PushSubscription[]
}

model Driver {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  pixKey        String?
  photoUrl      String?  @db.Text
  phone         String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  students          Student[]
  tripCancellations TripCancellation[]
  announcements     Announcement[]
  pushSubscriptions PushSubscription[]
  chatMessages      ChatMessage[]
}

model Student {
  id            String   @id @default(uuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  name          String
  email         String   @unique
  passwordHash  String
  photoUrl      String?  @db.Text
  phone         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  dailyStatuses     DailyStatus[]
  paymentCycles     PaymentCycle[]
  pushSubscriptions PushSubscription[]
  weeklySchedules   StudentWeeklySchedule[]
  chatMessages      ChatMessage[]

  @@index([driverId])
}

model ChatMessage {
  id         String    @id @default(uuid())
  driverId   String
  studentId  String
  senderRole String    // "driver" | "student"
  senderId   String    // ID do usuário remetente (Driver ou Student)
  content    String    @db.Text
  readAt     DateTime? // nulo = não lida; preenchido quando o destinatário visualiza
  createdAt  DateTime  @default(now())

  deletedForEveryoneAt DateTime?
  hiddenForDriver      Boolean   @default(false)
  hiddenForStudent     Boolean   @default(false)

  driver     Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([driverId, studentId, createdAt])
  @@index([studentId, readAt])
}

// Rotina semanal padrão do aluno (Segunda a Sábado/Domingo).
// Se o aluno não tiver registrado exceção pontual em DailyStatus para a data,
// o status do dia corresponderá ao configurado aqui para o dia da semana.
model StudentWeeklySchedule {
  id        String           @id @default(uuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dayOfWeek Int              // 0 = Domingo, 1 = Segunda, 2 = Terça, 3 = Quarta, 4 = Quinta, 5 = Sexta, 6 = Sábado
  status    DailyStatusValue @default(vai_normal)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, dayOfWeek])
  @@index([studentId])
}

// Um registro por aluno por dia. Se não existir registro para a data, o sistema
// consulta a rotina semanal padrão do aluno (ou assume "vai_normal").
model DailyStatus {
  id        String            @id @default(uuid())
  studentId String
  student   Student           @relation(fields: [studentId], references: [id])
  date      DateTime          @db.Date
  status    DailyStatusValue  @default(vai_normal)
  boardedAt DateTime?
  updatedAt DateTime          @updatedAt

  @@unique([studentId, date])
  @@index([date])
}

model TripCancellation {
  id        String   @id @default(uuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@unique([driverId, date])
}

model Announcement {
  id        String   @id @default(uuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@index([driverId, createdAt])
}

model PaymentCycle {
  id                  String    @id @default(uuid())
  studentId           String
  student             Student   @relation(fields: [studentId], references: [id])
  referenceMonth      DateTime  @db.Date
  reminderDaysBefore  Int       @default(3)
  paidAt              DateTime?
  markedBy            MarkedBy?
  paymentRequestedAt  DateTime?

  @@unique([studentId, referenceMonth])
}

model PushSubscription {
  id        String   @id @default(uuid())
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  adminId String?
  admin Admin? @relation(fields: [adminId], references: [id])
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([driverId])
  @@index([adminId])
}
